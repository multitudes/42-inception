# filepath: nginx/conf

# used to configure the events module, which handles connection processing. This block is required in the configuration file, even if it is empty.
events {}


# The http block 
http {
	server {
		listen 443 ssl;
		server_name ${DOMAIN_NAME:-localhost};
		# server_name lbrusa.42.de;
		ssl_protocols TLSv1.2 TLSv1.3;
		ssl_certificate /etc/nginx/ssl/nginx.crt;
		ssl_certificate_key /etc/nginx/ssl/nginx.key;

		location / {
			root /usr/share/nginx/html;
			index index.html;
		}

		# location ~ \.php$ {
